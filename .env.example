# Copy this file to .env and edit the values before running the server

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API
# For local development with Live Server this is usually http://127.0.0.1:5500
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Admin login credentials (used by pages/admin.html)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=technospark123

# Secret used to sign admin login tokens — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Public website URL used by the events page.
APP_URL=http://localhost:5500
